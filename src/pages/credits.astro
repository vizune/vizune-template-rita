---

<Layout
  title="Vizune Designs - Credits"
  description="Credits & Resources used by Vizune Designs."
  heading="Credits & Resources"
>
  <section class="space-y-10">
    <h2 class="mb-3">💻 Vizune Tech Stack</h2>
    <p class="text-sm">(Everything I use to make Vizune a reality)</p>

    <ul>
      {techStack.map((link) => (
        <li class="mb-3 ml-4 pl-1 list-disc">
          <span>{ link.description }</span> <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>
          {link.name2 && link.url2 && (<span>and <a href={link.url2} target="_blank" rel="noopener noreferrer">{link.name2}</a></span>)}
        </li>
      ))}
    </ul>

    <h2>🖼️ Image credits</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 justify-center">
      {imageSources.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white text-lg text-center font-medium hover:text-lavender transition"
        >
          <article
            class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-lg p-5
                    hover:border-white/20 hover:bg-white/[0.07] transition"
          >
            {link.name}
          </article>
        </a>
      ))}
    </div>

    <h2>✏️ Design credits</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 justify-center">
      {designSources.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white text-lg text-center font-medium hover:text-lavender transition"
        >
          <article
            class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-lg p-5
                    hover:border-white/20 hover:bg-white/[0.07] transition"
          >
            {link.name}
          </article>
        </a>
      ))}
    </div>
  </section>
</Layout>