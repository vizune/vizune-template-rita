---
/**
 * Style guide / template demo page.
 *
 * Shows every component and style used across the Rita template in one place,
 * using local sample data (no Contentful / .env needed), so it always renders.
 * Visit: http://localhost:4321/style-guide/
 */
import Layout from '@/layouts/Layout.astro';
import { Button, Icon } from '@/components';
import Tabs from '@/components/ui/Tabs.astro';
import FilterDropdown from '@/components/ui/FilterDropdown.astro';
import Pagination from '@/components/ui/Pagination.astro';
import BlogPost from '@/components/posts/BlogPost.astro';
import TutorialPost from '@/components/posts/TutorialPost.astro';
import RenderPost from '@/components/posts/RenderPost.astro';
import PsdPost from '@/components/posts/PsdPost.astro';
import ImageCaption from '@/components/ui/ImageCaption.astro';
import TemplateCarousel from '@/components/sections/TemplateCarousel.astro';

import arrowPng from '@/assets/arrow.png';
import header1200 from '@/assets/header-1200.png';
import ritaThumb from '@/assets/template-thumbnails/rita.jpg';
import inoriThumb from '@/assets/template-thumbnails/inori.jpg';
import chieThumb from '@/assets/template-thumbnails/chie.jpg';
import celtyThumb from '@/assets/template-thumbnails/celty.jpg';
import taliaThumb from '@/assets/template-thumbnails/talia.jpg';
import vizuneButton01 from '@/assets/buttons/vizune-button-01.png';
import vizuneButton02 from '@/assets/buttons/vizune-button-02.png';
import vizuneButton03 from '@/assets/buttons/vizune-button-03.png';

/* ------------------------------------------------------------------ */
/* Sample data, shaped like the Contentful responses the real pages use */
/* ------------------------------------------------------------------ */

const asset = (id: string, img: { src: string }, title: string) => ({
  sys: { id },
  fields: { title, description: title, file: { url: img.src } },
});

const assets = [
  asset('banner', header1200, 'Sample banner'),
  asset('rita', ritaThumb, 'Rita template'),
  asset('inori', inoriThumb, 'Inori template'),
  asset('chie', chieThumb, 'Chie template'),
  asset('celty', celtyThumb, 'Celty template'),
  asset('talia', taliaThumb, 'Talia template'),
];
const assetsById = new Map(assets.map((a) => [a.sys.id, a]));
const link = (id: string) => ({ sys: { id } });

const lorem =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse a ultrices tellus. In commodo massa vitae finibus semper.';

const blogPosts = [
  { sys: { id: 'b1' }, fields: { title: 'Featured blog post', slug: '#', publishDate: '2026-10-01', description: lorem, banner: link('banner'), thumbnail: link('rita') } },
  { sys: { id: 'b2' }, fields: { title: 'Blog post', slug: '#', publishDate: '2026-09-14', description: lorem, thumbnail: link('inori') } },
  { sys: { id: 'b3' }, fields: { title: 'Blog post', slug: '#', publishDate: '2026-08-20', description: lorem, thumbnail: link('chie') } },
];

const tutorialPosts = [
  { sys: { id: 't1' }, fields: { title: 'Tutorial post', slug: '#', publishDate: '2026-07-02', description: lorem, thumbnail: link('celty') } },
  { sys: { id: 't2' }, fields: { title: 'Tutorial post', slug: '#', publishDate: '2026-06-11', description: lorem, thumbnail: link('talia') } },
];

const renderPosts = [
  { metadata: { tags: [] }, sys: { id: 'r1' }, fields: { title: 'Render 001: Guilty Crown', date: '2013-10-13', imageDimensions: '800 x 1200', fileSize: '1.2 MB', downloadUrl: '#', thumbnail: link('inori') } },
  { metadata: { tags: [] }, sys: { id: 'r2' }, fields: { title: 'Render 002: Persona 4', date: '2013-10-14', imageDimensions: '1200 x 2200', fileSize: '2.3 MB', downloadUrl: '#', thumbnail: link('chie') } },
  { metadata: { tags: [] }, sys: { id: 'r3' }, fields: { title: 'Render 003: Durarara!!', date: '2013-10-14', imageDimensions: '1300 x 750', fileSize: '1.75 MB', downloadUrl: '#', thumbnail: link('celty') } },
];

const psdPosts = [
  { sys: { id: 'p1' }, fields: { title: 'PSD Pack 01', fileSize: '24 MB', url: '#', thumbnail: link('rita') } },
  { sys: { id: 'p2' }, fields: { title: 'PSD Pack 02', fileSize: '18 MB', url: '#', thumbnail: link('talia') } },
  { sys: { id: 'p3' }, fields: { title: 'PSD Pack 03', fileSize: '31 MB', url: '#', thumbnail: link('inori') } },
];

const templatePosts = [
  { sys: { id: 'tp1' }, fields: { title: 'Template: Inori', banner: link('inori'), publishDate: '2023-10-14', techStack: 'Vue, Vite, Tailwind', category: 'Anime/Manga', series: 'Guilty Crown', character: 'Inori Yuzuriha', demoUrl: '#', repoUrl: '#' } },
  { sys: { id: 'tp2' }, fields: { title: 'Template: Rita', banner: link('rita'), publishDate: '2026-01-01', techStack: 'Astro, Contentful', category: 'Video Game', series: '—', character: '—', demoUrl: '#', repoUrl: '#', downloadUrl: '#' } },
  { sys: { id: 'tp3' }, fields: { title: 'Template: Chie', banner: link('chie'), publishDate: '2023-10-14', techStack: 'HTML, Bootstrap', category: 'Video Game', series: 'Persona Q: Shadow of the Labyrinth', character: 'Chie Satonaka', demoUrl: '#', repoUrl: '#' } },
];

/* Filter + pagination demo items */
const filterItems = [
  ['Guilty Crown', 'anime'], ['Persona 4', 'game'], ['Durarara!!', 'anime'],
  ['Honkai Impact', 'game'], ['Kantai Collection', 'game'], ['Code Geass', 'anime'],
  ['Granblue Fantasy', 'game'], ['Puella Magi', 'anime'], ['Neptunia', 'game'],
];

const palette = [
  { name: 'hynacinth', hex: '#6f55d8' },
  { name: 'lavender', hex: '#646cff' },
  { name: 'indigo', hex: '#240470' },
  { name: 'orchid', hex: '#865eff' },
  { name: 'raven', hex: '#020007' },
  { name: 'clay', hex: '#f1edff' },
];

const toc = [
  ['typography', 'Typography'],
  ['colours', 'Colours'],
  ['buttons', 'Buttons'],
  ['tabs', 'Tabs'],
  ['filter', 'Filter & pagination'],
  ['cards', 'Cards'],
  ['blog', 'Blog posts'],
  ['tutorials', 'Tutorial posts'],
  ['renders', 'Render posts'],
  ['psd', 'PSD posts'],
  ['image-caption', 'Image & caption'],
  ['templates', 'Template cards'],
];
---

<Layout
  title="Vizune Designs - The Dusken Glow Template Style Guide"
  description="Every component and style used across the Rita web template, on one page."
  heading="The Dusken Glow Web Template"
>
  <div class="guide">

    <!-- Intro -->
    <section class="intro">
      <img src={ritaThumb.src} alt="Rita template thumbnail" width="160" class="intro-image" />
      <div class="muted-strong">
        <p>
          This page gathers every component and style used across the <em>Dusken Glow</em> template.
          It was built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>.
          You can browse the code on <a href="https://github.com/vizune" target="_blank" rel="noopener noreferrer">my GitHub</a>.
        </p>
      </div>
    </section>

    <!-- Table of contents -->
    <nav aria-label="Style guide sections" class="toc glass">
      <ul class="toc-list">
        {toc.map(([id, label]) => (
          <li><a href={`#${id}`} class="toc-link">{label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Typography -->
    <section id="typography" class="guide-section">
      <h2 class="section-title">Typography</h2>
      <div class="specimen">
        <h1 class="specimen-h1">Heading 1</h1>
        <h2 class="specimen-h2">Heading 2</h2>
        <h3 class="specimen-h3">Heading 3</h3>
        <h4 class="specimen-h4">Heading 4</h4>
        <h2 class="specimen-h3">💖 Section heading (lowercase) 🌟</h2>
        <p>Body copy. {lorem} <strong>Bold text</strong>, <em>italic text</em> and <a href="#typography">an inline link</a>.</p>
        <p class="muted">Muted copy (white at 80%), used for descriptions.</p>
        <p class="meta">Meta copy (white at 60%, small), used for dates: 📅 27/10/2026</p>
        <p class="small">(Small print, used for notes)</p>
        <ul>
          <li class="list-item">List item with <a href="#typography">a link</a></li>
          <li class="list-item">List item</li>
          <li class="list-item">List item</li>
        </ul>
        <hr class="rule" />
      </div>
    </section>

    <!-- Colours -->
    <section id="colours" class="guide-section">
      <h2 class="section-title">Colours</h2>
      <div class="swatches">
        {palette.map((c) => (
          <div class="swatch glass">
            <div class="swatch-colour" style={`background-color: var(--color-${c.name})`}></div>
            <div class="swatch-label">
              <strong>{c.name}</strong><br />
              <span class="meta">{c.hex}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Buttons -->
    <section id="buttons" class="guide-section">
      <h2 class="section-title">Buttons</h2>
      <div class="stack">
        <div>
          <h3 class="demo-title">Primary button</h3>
          <div class="row row--wide">
            <Button href="#buttons">Link back / link exchanges</Button>
            <Button href="#buttons" external>External link <Icon name="newTab" size="small" /></Button>
          </div>
        </div>

        <div>
          <h3 class="demo-title">Download button (renders, PSDs)</h3>
          <a href="#buttons" class="Button download-button download-demo">
            Download (24 MB) <Icon name="newTab" title="Opens url in a new tab" size="small" />
          </a>
        </div>

        <div>
          <h3 class="demo-title">Glass buttons (filter, pagination)</h3>
          <div class="row">
            <button type="button" class="glass-button">Clear filter</button>
            <button type="button" class="glass-button glass-button--small">Prev</button>
            <button type="button" class="glass-button glass-button--small" disabled>Next (disabled)</button>
          </div>
        </div>

        <div>
          <h3 class="demo-title">Cookie banner buttons</h3>
          <div class="row row--tight">
            <button type="button" class="cookie-button cookie-button--decline">Decline</button>
            <button type="button" class="cookie-button cookie-button--accept">Accept</button>
          </div>
        </div>

        <div>
          <h3 class="demo-title">Round arrow buttons (templates carousel)</h3>
          <div class="arrow-row">
            <button type="button" aria-label="Previous" class="round-button round-button--prev">
              <img src={arrowPng.src} alt="" aria-hidden="true" />
            </button>
            <button type="button" aria-label="Next" class="round-button">
              <img src={arrowPng.src} alt="" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div>
          <h3 class="demo-title">Affiliate button (hover to reveal 88×31)</h3>
          <a href="#buttons" class="Button affiliate-button">
            <span>Vizune</span>
            <img src={vizuneButton01.src} alt="Vizune button" width="88" height="31" />
          </a>
        </div>
      </div>
    </section>

    <!-- Tabs -->
    <section id="tabs" class="guide-section">
      <h2 class="section-title">Tabs component</h2>
      <Tabs>
        <ui-tab>Tab 1</ui-tab>
        <ui-tab>Tab 2</ui-tab>
        <ui-tab>Tab 3</ui-tab>
        <ui-panel><p>Tab 1 content. {lorem} {lorem}</p></ui-panel>
        <ui-panel><p>Tab 2 content. {lorem}</p></ui-panel>
        <ui-panel><p>Tab 3 content. {lorem} {lorem} {lorem}</p></ui-panel>
      </Tabs>
    </section>

    <!-- Filter + pagination -->
    <section id="filter" class="guide-section">
      <h2 class="section-title">Filter dropdown &amp; pagination</h2>
      <div class="styleguide-filter" data-section="styleguide">
        <FilterDropdown>
          <option value="">-- Filter content --</option>
          <option value="anime">Anime (4)</option>
          <option value="game">Video games (5)</option>
        </FilterDropdown>

        <div class="filter-grid">
          {filterItems.map(([name, tag]) => (
            <div class="styleguide-item glass" data-tags={tag}>
              {name}
              <span class="filter-tag meta">{tag}</span>
            </div>
          ))}
        </div>

        <Pagination id="styleguide" pageSize={3} />
      </div>

      <script is:inline>
        (() => {
          const root = document.querySelector('.styleguide-filter[data-section="styleguide"]');
          if (!root) return;

          const pageSize = 3;
          const select = root.querySelector('select');
          const clearBtn = root.querySelector('[data-clear-filter]');
          const cards = Array.from(root.querySelectorAll('.styleguide-item'));
          const pagination = root.querySelector('[data-pagination-id="styleguide"]');

          let currentTag = '';
          let currentPage = 1;

          const matches = (card) => !currentTag || (card.dataset.tags || '').split(/\s+/).includes(currentTag);

          function apply() {
            const matched = cards.filter(matches);
            const start = (currentPage - 1) * pageSize;
            cards.forEach((card) => { card.hidden = true; });
            matched.slice(start, start + pageSize).forEach((card) => { card.hidden = false; });

            pagination?.dispatchEvent(new CustomEvent('pagination:set', {
              detail: { total: matched.length, pageSize, page: currentPage },
            }));
          }

          select?.addEventListener('change', (e) => {
            currentTag = e.currentTarget.value;
            currentPage = 1;
            apply();
          });

          clearBtn?.addEventListener('click', () => {
            if (select) select.value = '';
            currentTag = '';
            currentPage = 1;
            apply();
          });

          pagination?.addEventListener('pagination:change', (e) => {
            currentPage = e.detail?.page || 1;
            apply();
          });

          apply();
        })();
      </script>
    </section>

    <!-- Generic cards -->
    <section id="cards" class="guide-section">
      <h2 class="section-title">Cards</h2>
      <div class="stack">
        <div>
          <h3 class="demo-title">Glass card</h3>
          <div class="glass-demo glass">
            <p class="muted">{lorem}</p>
          </div>
        </div>

        <div>
          <h3 class="demo-title">Link cards (credits, link exchanges)</h3>
          <div class="card-grid">
            {['MiniTokyo', 'Zerochan', 'Creative Uncut', 'Shuushuu'].map((name) => (
              <a href="#cards" class="link-card">
                <article class="link-card-body glass">{name}</article>
              </a>
            ))}
          </div>
        </div>

        <div>
          <h3 class="demo-title">Button cards</h3>
          <div class="button-grid">
            {[vizuneButton03, vizuneButton01, vizuneButton02].map((img) => (
              <div class="button-tile glass">
                <img src={img.src} alt="Vizune link button" width="88" height="31" class="pixelated" />
              </div>
            ))}
          </div>
          <div class="card-grid">
            {[vizuneButton01, vizuneButton02].map((img, i) => (
              <a href="#cards" class="exchange-card glass">
                <article>
                  <h3 class="exchange-title">Link exchange {i + 1}</h3>
                  <div class="exchange-frame">
                    <img src={img.src} alt="Sample button" width="88" height="31" class="pixelated" />
                  </div>
                </article>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Blog posts -->
    <section id="blog" class="guide-section">
      <h2 class="section-title">Blog posts</h2>
      <div class="post-grid">
        <div class="span-full">
          <BlogPost post={blogPosts[0]} assetsById={assetsById} featured />
        </div>
        <BlogPost post={blogPosts[1]} assetsById={assetsById} />
        <BlogPost post={blogPosts[2]} assetsById={assetsById} />
      </div>
    </section>

    <!-- Tutorial posts -->
    <section id="tutorials" class="guide-section">
      <h2 class="section-title">Tutorial posts</h2>
      <div class="post-grid">
        {tutorialPosts.map((post) => <TutorialPost post={post} assetsById={assetsById} />)}
      </div>
    </section>

    <!-- Render posts -->
    <section id="renders" class="guide-section">
      <h2 class="section-title">Render posts</h2>
      <div class="render-grid">
        {renderPosts.map((post) => <RenderPost post={post} assetsById={assetsById} />)}
      </div>
    </section>

    <!-- PSD posts -->
    <section id="psd" class="guide-section">
      <h2 class="section-title">PSD posts</h2>
      <div class="psd-grid">
        {psdPosts.map((post) => <PsdPost post={post} assetsById={assetsById} />)}
      </div>
    </section>

    <!-- Image + caption -->
    <section id="image-caption" class="guide-section">
      <h2 class="section-title">Image &amp; caption</h2>
      <div class="caption-grid">
        <ImageCaption src={inoriThumb.src} alt="Inori template preview">
          <strong>#1:</strong> Guilty Crown
        </ImageCaption>
        <ImageCaption src={chieThumb.src} alt="Chie template preview" caption="Caption passed as a prop" />
      </div>
    </section>

    <!-- Template tarot carousel -->
    <section id="templates" class="guide-section">
      <h2 class="section-title">Template carousel</h2>
      <TemplateCarousel posts={templatePosts} assetsById={assetsById} startIndex={1} location="style_guide" />
    </section>

  </div>
</Layout>

<style>
  .guide {
    color: #fff;
  }

  .guide > :not(:last-child) {
    margin-bottom: 5rem;
  }

  .guide-section {
    scroll-margin-top: 2rem;
  }

  .section-title {
    margin-bottom: 1.5rem;
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
  }

  .demo-title {
    margin-bottom: 0.75rem;
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
  }

  .stack > :not(:last-child) {
    margin-bottom: 2rem;
  }

  .muted-strong {
    color: rgb(255 255 255 / 0.85);
  }

  .muted {
    color: rgb(255 255 255 / 0.8);
  }

  .meta {
    color: rgb(255 255 255 / 0.6);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .small {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .pixelated {
    image-rendering: pixelated;
  }

  /* Intro */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .intro-image {
    flex-shrink: 0;
    margin-inline: auto;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 768px) {
    .intro {
      flex-direction: row;
    }

    .intro-image {
      margin-inline: 0;
    }
  }

  /* Table of contents */
  .toc {
    padding: 1.25rem;
  }

  .toc-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }

  .toc-link {
    transition: color var(--transition);
  }

  .toc-link:hover {
    color: var(--color-lavender);
  }

  /* Typography */
  .specimen > :not(:last-child) {
    margin-bottom: 1rem;
  }

  .specimen-h1 {
    color: var(--color-clay);
    text-align: left;
    text-shadow: 0 0 18px rgba(134, 94, 255, 0.25);
  }

  .specimen-h2 {
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
  }

  .specimen-h3 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
  }

  .specimen-h4 {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
  }

  .list-item {
    margin: 0 0 0.75rem 1rem;
    padding-left: 0.25rem;
    list-style-type: disc;
  }

  .rule {
    margin-block: 1.5rem;
    border-color: rgb(255 255 255 / 0.1);
  }

  /* Colours */
  .swatches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .swatch {
    overflow: hidden;
  }

  .swatch-colour {
    height: 5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .swatch-label {
    padding: 0.75rem;
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }

  /* Buttons */
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .row--wide {
    gap: 1.5rem;
  }

  .row--tight {
    gap: 0.75rem;
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }

  .arrow-row {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .download-demo {
    max-width: 24rem;
  }

  /* Filter + pagination */
  .filter-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .styleguide-item {
    padding: 1.25rem;
    text-align: center;
  }

  .filter-tag {
    display: block;
  }

  /* Cards */
  .glass-demo {
    max-width: 36rem;
    padding: 1.5rem;
  }

  .card-grid {
    display: grid;
    gap: 1rem;
  }

  .link-card {
    color: #fff;
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    font-weight: 500;
    text-align: center;
    transition: color var(--transition);
  }

  .link-card:hover {
    color: var(--color-lavender);
  }

  .link-card-body {
    padding: 1.25rem;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .link-card-body:hover,
  .exchange-card:hover {
    border-color: rgb(255 255 255 / 0.2);
    background-color: rgb(255 255 255 / 0.07);
  }

  .button-grid {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-bottom: 1.5rem;
  }

  .button-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .exchange-card {
    display: block;
    padding: 1.25rem;
    transition: border-color var(--transition), background-color var(--transition), color var(--transition);
  }

  .exchange-card:hover {
    color: var(--color-lavender);
  }

  .exchange-title {
    margin-bottom: 1rem;
    font-size: var(--text-base);
    line-height: var(--leading-base);
    text-align: center;
  }

  .exchange-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 92px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-xl);
    background-color: rgb(0 0 0 / 0.2);
    transition: background-color var(--transition);
  }

  .exchange-card:hover .exchange-frame {
    background-color: rgb(0 0 0 / 0.3);
  }

  /* Post grids */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2.25rem;
  }

  .render-grid {
    display: grid;
    gap: 1rem;
  }

  .psd-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .caption-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 400px));
    justify-content: center;
