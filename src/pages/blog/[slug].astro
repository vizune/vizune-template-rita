---
import Layout from '@/layouts/Layout.astro';
import {
  fetchContentfulEntries,
  formatUkDate,
  richTextToHtml,
  type RichTextDocument,
  type ContentfulEntry,
} from '@/lib/contentful';

type BlogFields = {
  title?: string;
  slug?: string;
  banner?: {
    sys: {
      type: 'Link';
      linkType: 'Asset';
      id: string;
    };
  };
  publishDate?: string;
  description?: string;
  content?: RichTextDocument;
};

export async function getStaticPaths() {
  const { items, assets } = await fetchContentfulEntries<BlogFields>('articles');
  const assetsById = Object.fromEntries(assets.map((asset) => [asset.sys.id, asset]));

  return items
    .filter((item) => item.fields?.slug)
    .map((item) => ({
      params: { slug: item.fields.slug! },
      props: {
        entry: item,
        assetsById,
      },
    }));
}

const {
  entry,
  assetsById,
} = Astro.props as {
  entry: ContentfulEntry<BlogFields>;
  assetsById: Record<string, unknown>;
};

const title = entry.fields.title ?? 'Blog post';
const description = entry.fields.description ?? title;
const date = formatUkDate(entry.fields.publishDate);
const entryID = entry.sys.id;
const bannerId = entry.fields.banner?.sys.id;

const banner = bannerId
  ? (assetsById[bannerId] as {
      fields?: {
        file?: {
          url?: string;
        };
        title?: string;
        description?: string;
      };
    })
  : undefined;

const bannerUrl = banner?.fields?.file?.url
  ? `https:${banner.fields.file.url}`
  : undefined;

const bannerAlt =
  banner?.fields?.description ??
  banner?.fields?.title ??
  title;

const html = richTextToHtml(
  entry.fields.content,
  new Map(Object.entries(assetsById))
);

const pageUrl = Astro.url.href;

---

<Layout
  title={`Vizune Designs - ${title}`}
  description={description}
  heading={title}
>
  <article class="home-article max-w-4xl mx-auto">
    {
    bannerUrl && (
      <img
        src={bannerUrl}
        alt={bannerAlt}
        class="mx-auto mb-8"
      />
    )
  }
    <div class="prose prose-invert max-w-none">
      {date ? <span class="mb-0">📅 Published {date}</span> : null}

      <hr class="mt-4 mb-10" />

      <div set:html={html} />

    </div>

    <hr class="my-10 border-white/10" />

    <section class="mt-8">
      <div id="disqus_thread"></div>
      <noscript>
        Please enable JavaScript to view the comments powered by Disqus.
      </noscript>
    </section>
  </article>

  <script is:inline define:vars={{ pageUrl, entryID }}>
    window.disqus_config = function () {
      this.page.url = pageUrl;
      this.page.identifier = entryID;
    };

    (() => {
      const d = document;
      const s = d.createElement('script');
      s.src = 'https://vizune.disqus.com/embed.js';
      s.setAttribute('data-timestamp', String(+new Date()));
      (d.head || d.body).appendChild(s);
    })();
  </script>
</Layout>

<style is:global>
  .prose {
    background-color: #fff;
    color: #333;
    border-radius: 20px;
    padding: 1.5rem;
  }

  .prose h2 {
    font-size: 2.75rem;
  }

  .home-article .prose .content-image {
    margin: 2rem 0;
    display: inline-block;
    max-width: 33%;
  }

  .prose ul {
    list-style: square;
    padding-left: 1.25rem;
    margin: 1rem 0;
  }
</style>