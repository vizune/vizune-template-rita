---
import Layout from '@/layouts/Layout.astro';
import Pagination from '@/components/ui/Pagination.astro';
import PsdPost from '@/components/posts/PsdPost.astro';

type PsdPost = {
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    publishDate?: string;
    url?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: { file?: { url?: string }; title?: string; description?: string };
};

const data = await fetch(import.meta.env.PUBLIC_POSTS_PSDS).then((r) => r.json());
const items: PsdPost[] = (data?.items ?? []) as PsdPost[];
const assets: Asset[] = (data?.includes?.Asset ?? []) as Asset[];

const assetsById = new Map<string, Asset>(assets.map((a) => [a.sys.id, a]));

const toTime = (d?: string) => {
  const t = d ? Date.parse(d) : NaN;
  return Number.isFinite(t) ? t : -Infinity;
};

const sorted = [...items].sort(
  (a, b) => toTime(b.fields.publishDate) - toTime(a.fields.publishDate)
);

const pageSize = 9;
---

<Layout title="Vizune.com - PSD Downloads" heading="PSD Downloads" description="Photoshop PSD downloads.">
  <div class="psd-list" id="psd-wrapper" data-section="psd">
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-9" data-grid>
      {sorted.map((post) => (
        <PsdPost post={post} assetsById={assetsById} />
      ))}
    </div>

    <Pagination id="psd" pageSize={pageSize} />

    <script is:inline define:vars={{ pageSize }}>
      const root = document.querySelector('.psd-list[data-section="psd"]');
      if (!root) return;

      const cards = Array.from(root.querySelectorAll('.psd-card'));
      const pagination = root.querySelector('[data-pagination-id="psd"]');
      const section = document.getElementById('psd-wrapper');

      let currentPage = 1;

      function applyPagination() {
        const total = cards.length;

        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;

        cards.forEach((c, idx) => {
          c.classList.toggle('hidden', !(idx >= start && idx < end));
        });

        pagination?.dispatchEvent(
          new CustomEvent('pagination:set', {
            detail: { total, pageSize, page: currentPage },
          })
        );
      }

      function smoothScrollTo(targetY, duration = 800) {
        const startY = window.scrollY;
        const diff = targetY - startY;
        const startTime = performance.now();

        function easeInOutCubic(t) {
          return t < 0.5
            ? 4 * t * t * t
            : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        function step(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = easeInOutCubic(progress);
          window.scrollTo(0, startY + diff * eased);
          if (progress < 1) requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
      }

      // init
      applyPagination();

      pagination?.addEventListener('pagination:change', (e) => {
        currentPage = e.detail?.page || 1;
        applyPagination();

        if (section) {
          const y = section.getBoundingClientRect().top + window.scrollY - 16;
          smoothScrollTo(y, 1000);
        }
      });
    </script>
  </div>
</Layout>