---

import Layout from '@/layouts/Layout.astro';

const posts = await fetch(import.meta.env.PUBLIC_POSTS_RENDERS).then((r) => r.json());

const sortPostsByIndex = posts => {
  return posts.items.sort((a,b) => a.fields.index < b.fields.index ? 1 : -1);
}

---

<Layout title="Vizune Designs - Renders" heading="Vizune Renders" description="...">
    {JSON.stringify(posts)}
</Layout>