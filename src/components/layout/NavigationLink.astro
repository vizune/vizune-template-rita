---
const { page, link } = Astro.props;
---

<div class="z-20 block w-full md:w-auto">
<a
  href={link}
  class="relative block w-full p-4 md:p-5
         text-white
         border-b-2 md:border-b-0 border-indigo
         overflow-hidden
         transform-gpu transition-colors duration-300 ease-in-out
         before:content-[''] before:absolute before:inset-0 before:-z-10
         before:bg-indigo/60
         before:origin-top before:scale-y-0
         before:transform-gpu
         before:transition-transform before:duration-500
         before:ease-[cubic-bezier(0.22,1,0.36,1)]
         hover:before:scale-y-100"
>
    <span class="text-lg uppercase font-medium tracking-widest">{page}</span>
  </a>
</div>
