---
const { page, link } = Astro.props;
---

<div class="nav-item">
<a href={link} class="nav-link">
    <span class="label">{page}</span>
  </a>
</div>

<style>
.nav-item {
  z-index: 20;
  display: block;
  width: 100%;
}

.nav-link {
  position: relative;
  display: block;
  width: 100%;
  padding: 1rem;
  border-bottom: 2px solid var(--color-indigo);
  overflow: hidden;
  color: #fff;
  transform: translateZ(0);
  transition: color 300ms var(--ease), background-color 300ms var(--ease), border-color 300ms var(--ease);
}

/* Indigo fill that wipes down from the top on hover */
.nav-link::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -10;
  background-color: color-mix(in oklab, var(--color-indigo) 60%, transparent);
  transform: translateZ(0);
  transform-origin: top;
  scale: 1 0;
  transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), scale 500ms cubic-bezier(0.22, 1, 0.36, 1);
}

.nav-link:hover::before {
  scale: 1 1;
}

@media (min-width: 768px) {
  .nav-item {
    width: auto;
  }

  .nav-link {
    padding: 1.25rem;
    border-bottom-width: 0;
  }
}

.label {
  font-size: var(--text-lg);
  line-height: var(--leading-lg);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
</style>
