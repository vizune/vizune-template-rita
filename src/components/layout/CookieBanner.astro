---
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="message">
    This site uses analytics cookies to understand how visitors use the site.<br />
    No personal data is stored. You can accept or decline.
  </p>

  <div class="actions">
    <button id="cookie-decline" class="cookie-button cookie-button--decline">
      Decline
    </button>

    <button id="cookie-accept" class="cookie-button cookie-button--accept">
      Accept
    </button>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  const consent = localStorage.getItem('vizune-cookie-consent');

  function loadGA() {
    if (!GA_ID) return;

    const script1 = document.createElement('script');
    script1.async = true;
    script1.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script1);

    const script2 = document.createElement('script');
    script2.innerHTML = `
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', '${GA_ID}', { anonymize_ip: true });
    `;
    document.head.appendChild(script2);
  }

  if (!consent && banner) {
    banner.hidden = false;
  }

  if (consent === 'accepted') {
    loadGA();
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem('vizune-cookie-consent', 'accepted');
    banner?.remove();
    loadGA();
  });

  declineBtn?.addEventListener('click', () => {
    localStorage.setItem('vizune-cookie-consent', 'declined');
    banner?.remove();
  });
</script>

<style>
.cookie-banner {
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  z-index: 50;
  translate: -50% 0;
  width: 90%;
  max-width: 36rem;
  padding: 1.25rem;
  border: 1px solid rgb(255 255 255 / 0.1);
  border-radius: var(--radius-2xl);
  background-color: rgb(0 0 0 / 0.8);
  color: #fff;
  backdrop-filter: blur(var(--blur-md));
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
}

.message {
  margin-bottom: 1rem;
  font-size: var(--text-sm);
  line-height: 1.625;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
}
</style>
