---
import { NavigationLink } from '@/components';

const nav = [
  { page: "Home",        link: "/" },
  { page: "Style guide", link: "/style-guide/" },
];
---
<nav class="nav">
  {nav.map((item) => (
    <NavigationLink page={item.page} link={item.link} />
  ))}
</nav>

<style>
.nav {
  z-index: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: -5rem;
  background-color: var(--color-raven);
  text-align: center;
}

@media (min-width: 768px) {
  .nav {
    flex-direction: row;
    border-bottom: 2px solid color-mix(in oklab, var(--color-indigo) 60%, transparent);
  }
}
</style>
