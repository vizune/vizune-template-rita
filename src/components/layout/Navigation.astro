---
import { NavigationLink } from '@/components';

const nav = [
  { page: "Home",        link: "/" },
  { page: "Style guide", link: "/style-guide/" },
];
---
<nav class="z-0 w-full bg-raven -mt-20 md:border-indigo/60 md:border-b-2 md:border-opacity-25 flex flex-col md:flex-row items-center justify-center text-center">
  {nav.map((item) => (
    <NavigationLink page={item.page} link={item.link} />
  ))}
</nav>
