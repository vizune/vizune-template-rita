---
import { Mandala } from '@/components';

import Header2560 from '@/assets/header-large.png';
import Header1920 from '@/assets/header.jpg';
import Header1600 from '@/assets/header-1600.png';
import Header1200 from '@/assets/header-1200.png';
import Header768 from '@/assets/header-768.png';
---

<header class="Header">
	<div class="branding">
		<span class="title">Vizune</span>
		<span class="tagline">· The Dusken Glow</span>
			<div style="margin-top: -20rem; width: 1900px; position: absolute; left: 50%; transform: translateX(-50%);">
				<Mandala />
			</div>
	</div>
	<div class="banner">
		<picture>
			<source srcset={Header2560.src} media="(min-width: 2000px)" />
			<source srcset={Header1920.src} media="(max-width: 1999px)" />
			<source srcset={Header1600.src} media="(max-width: 1600px)" />
			<source srcset={Header1200.src} media="(max-width: 1200px)" />
			<source srcset={Header768.src} media="(max-width: 768px)" />
			<img
				src={Header768.src}
				alt="Vizune banner"
				class="banner-image"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
	</div>
</header>

<style scoped>
.Header {
	position: relative;
	width: 100%;
	height: 43.75rem;
	padding-top: 0.25rem;
	padding-bottom: 1.5rem;
}

.branding {
	margin-top: 1.5rem;
	text-align: center;
}

@media (min-width: 768px) {
	.branding {
		margin-top: 0.5rem;
	}
}

.title,
.tagline {
	color: #fff;
	text-transform: uppercase;
	letter-spacing: 0.1em;
}

.title {
	font-size: var(--text-4xl);
	line-height: var(--leading-4xl);
	font-weight: 200;
}

@media (min-width: 768px) {
	.title {
		font-size: var(--text-6xl);
		line-height: var(--leading-6xl);
	}
}

.tagline {
	font-size: var(--text-xl);
	line-height: var(--leading-xl);
	font-weight: 300;
}

.banner {
	position: absolute;
	top: 50%;
	left: 50%;
	z-index: 10;
	width: 100%;
	translate: -50% -50%;
	border-block: 20px solid #000;
}

.banner-image {
	width: 100%;
	height: 500px;
	object-fit: cover;
}

.Header:before {
    content: '';
    width: 750px;
    height: 620px;
    position: absolute;
    display: block;
	top: .75rem;
    left: 50%;
    border-radius: 50%;
    background: linear-gradient(-23deg, rgb(80, 8, 255) 75%, rgb(233, 151, 255) 50%);
    filter: blur(70px);
	transform: translateX(-50%) scale(0.85);
    animation: pulseScale 3s linear infinite 1s;
    pointer-events: none;
}
@keyframes pulseScale {
  0%   { transform: translateX(-50%) scale(0.85); }
  50%  { transform: translateX(-50%) scale(1); }
  100% { transform: translateX(-50%) scale(0.85); }
}
</style>
