---
const { heading } = Astro.props;
import Divider from '@/assets/divider.svg';
---

<main class="page">
  <section class="panel container">
    <header class="panel-header">
      <h1 class="heading">
        {heading}
      </h1>
      <img
        src={Divider.src}
        alt=""
        aria-hidden="true"
        class="divider"
        loading="eager"
      />
    </header>

    <div class="content">
      <slot />
    </div>
  </section>
</main>

<style>
.page {
  padding: 4rem 1rem;
  background-image:
    radial-gradient(1200px 680px at 50% 120%, rgba(59, 47, 99, 0.95) 0%, rgba(0, 0, 0, 0.55) 45%, transparent 75%),
    linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.55) 60%, rgba(0, 0, 0, 0.8));
}

.panel {
  padding: 2rem;
  border: 1px solid rgba(214, 201, 255, 0.14);
  border-radius: 22px;
  background-color: rgba(14, 14, 26, 0.6);
  backdrop-filter: blur(6px) saturate(1.2);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.panel-header {
  position: relative;
  padding-top: 1rem;
  padding-bottom: 2rem;
  margin-bottom: 1.5rem;
}

.heading {
  margin-top: 1.25rem;
  margin-bottom: 2.5rem;
  color: var(--color-clay);
  text-shadow: 0 0 18px rgba(134, 94, 255, 0.25);
}

.divider {
  width: min(55rem, 88%);
  margin-top: 0.5rem;
  margin-inline: auto;
  opacity: 0.9;
  filter: drop-shadow(0 0 10px rgba(134, 94, 255, 0.25));
  pointer-events: none;
}

.content {
  font-size: var(--text-xl);
  line-height: var(--leading-xl);
}
</style>
