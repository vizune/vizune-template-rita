---
const { href, external } = Astro.props;
---
<a
  href={href}
  target={external && '_blank'}
  class="Button"
>
  <slot />
</a>

<style>
.Button {
  --button-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08);

  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  border: 1px solid color-mix(in oklab, var(--color-hynacinth) 50%, transparent);
  border-radius: var(--radius-xl);
  background-image: linear-gradient(180deg, rgba(134, 94, 255, 0.35), rgba(36, 4, 112, 0.6));
  box-shadow: var(--button-shadow);
  color: #fff;
  font-size: var(--text-base);
  line-height: var(--leading-base);
  letter-spacing: 0.1em;
  backface-visibility: hidden;
  transition: all 600ms var(--ease);
}

.Button:hover {
  --button-shadow: 0 14px 40px rgba(134, 94, 255, 0.3);

  translate: 0 2px;
  scale: 0.97;
}

.Button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-orchid) 70%, transparent), var(--button-shadow);
}

.Button:active {
  translate: 0 1px;
}
</style>
