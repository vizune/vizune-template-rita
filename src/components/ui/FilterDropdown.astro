---
interface Props {
  value?: string;
  disabled?: boolean;

  // Callbacks (optional)
  onChange?: (value: string) => void;
  onClear?: () => void;
}

const {
  value = '',
  disabled = false,
  onChange,
  onClear,
} = Astro.props;

const clearDisabled = disabled || value.length === 0;
---

<div class="filter">
  <div class="select-wrapper">
    <select
      class="select"
      value={value}
      onChange={(e) => onChange?.((e.currentTarget as HTMLSelectElement).value)}
    >
      <slot />
    </select>
    <span class="chevron">
    <svg viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.24 4.38a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </span>
  </div>

  <button
    type="button"
    data-clear-filter
    class="clear glass-button"
  >
    Clear filter
  </button>
</div>

<style>
.filter {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

.select-wrapper {
  position: relative;
  width: 100%;
}

.select {
  width: 100%;
  height: 3rem;
  padding-inline: 1rem 2.75rem;
  appearance: none;
  border: 1px solid rgb(255 255 255 / 0.1);
  border-radius: var(--radius-xl);
  background-color: rgb(255 255 255 / 0.05);
  color: rgb(255 255 255 / 0.9);
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04), 0 10px 30px -10px rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(var(--blur-md));
  transition: background-color var(--transition), border-color var(--transition), box-shadow var(--transition);
}

.select:hover {
  border-color: rgb(255 255 255 / 0.15);
  background-color: rgb(255 255 255 / 0.07);
}

.select:focus {
  outline: none;
  border-color: rgb(196 181 253 / 0.4);
  box-shadow: 0 0 0 2px rgb(167 139 250 / 0.4), 0 0 0 1px rgba(255, 255, 255, 0.04), 0 10px 30px -10px rgba(0, 0, 0, 0.7);
}

@media (min-width: 768px) {
  .select-wrapper,
  .select {
    width: 20rem;
  }
}

.chevron {
  position: absolute;
  top: 0;
  right: 0.75rem;
  bottom: 0;
  display: flex;
  align-items: center;
  color: rgb(255 255 255 / 0.6);
  pointer-events: none;
}

.chevron svg {
  width: 1rem;
  height: 1rem;
}

.clear:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgb(167 139 250 / 0.4);
}
</style>
