---
interface Props {
  value?: string;
  disabled?: boolean;

  // Callbacks (optional)
  onChange?: (value: string) => void;
  onClear?: () => void;
}

const {
  value = '',
  disabled = false,
  onChange,
  onClear,
} = Astro.props;

const clearDisabled = disabled || value.length === 0;
---

<div class="flex flex-wrap gap-4 justify-center">
  <div class="relative w-full md:w-80">
    <select
      class="
        h-12 w-full md:w-80
        appearance-none
        rounded-xl
        bg-white/5
        text-white/90
        placeholder:text-white/40
        border border-white/10
        px-4 pr-11
        shadow-[0_0_0_1px_rgba(255,255,255,0.04),0_10px_30px_-10px_rgba(0,0,0,0.7)]
        backdrop-blur-md
        transition
        hover:bg-white/7 hover:border-white/15
        focus:outline-none
        focus:ring-2 focus:ring-violet-400/40
        focus:border-violet-300/40
      "
      value={value}
      onChange={(e) => onChange?.((e.currentTarget as HTMLSelectElement).value)}
    >
      <slot />
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-white/60">
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.24 4.38a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </span>
  </div>

  <button
    type="button"
    data-clear-filter
    class="
      h-12 rounded-xl px-5 bg-white/5 text-white/85 border border-white/10
      backdrop-blur-md transition hover:bg-white/10 hover:border-white/20
      focus:outline-none focus:ring-2 focus:ring-violet-400/40
      disabled:opacity-40 disabled:cursor-not-allowed
    "
  >
    Clear filter
  </button>
</div>
