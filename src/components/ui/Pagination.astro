---
interface Props {
  id: string;
  pageSize?: number;
}

const { id, pageSize = 12 } = Astro.props;
---

<nav
  class="mt-8 flex items-center justify-center gap-3"
  data-pagination
  data-pagination-id={id}
  data-page-size={pageSize}
>
  <button
    type="button"
    data-page-prev
    class="h-10 rounded-xl px-4 bg-white/5 text-white/85 border border-white/10
           backdrop-blur-md transition hover:bg-white/10 hover:border-white/20
           disabled:opacity-40 disabled:cursor-not-allowed"
  >
    Prev
  </button>

  <div class="text-white/70 text-sm hidden" data-page-label>
    Page 1 of 1
  </div>

  <button
    type="button"
    data-page-next
    class="h-10 rounded-xl px-4 bg-white/5 text-white/85 border border-white/10
           backdrop-blur-md transition hover:bg-white/10 hover:border-white/20
           disabled:opacity-40 disabled:cursor-not-allowed"
  >
    Next
  </button>
</nav>

<script is:inline define:vars={{ id }}>
  (() => {
    const el = document.querySelector(
      `[data-pagination][data-pagination-id="${id}"]`
    );

    if (!el) return;

    const prevBtn = el.querySelector('[data-page-prev]');
    const nextBtn = el.querySelector('[data-page-next]');
    const label = el.querySelector('[data-page-label]');

    const state = {
      page: 1,
      pageSize: Number(el.getAttribute('data-page-size') || 12),
      total: 0,
    };

    function totalPages() {
      return Math.max(1, Math.ceil(state.total / state.pageSize));
    }

    function render() {
      const pages = totalPages();

      state.page = Math.min(
        Math.max(1, state.page),
        pages
      );

      if (label) {
        label.textContent = `Page ${state.page} of ${pages}`;
        label.classList.remove('hidden');
      }

      if (prevBtn) {
        prevBtn.disabled = state.page <= 1;
      }

      if (nextBtn) {
        nextBtn.disabled = state.page >= pages;
      }
    }

    function emitChange() {
      el.dispatchEvent(
        new CustomEvent('pagination:change', {
          bubbles: true,
          detail: {
            page: state.page,
            pageSize: state.pageSize,
          },
        })
      );
    }

    prevBtn?.addEventListener('click', () => {
      state.page -= 1;
      render();
      emitChange();
    });

    nextBtn?.addEventListener('click', () => {
      state.page += 1;
      render();
      emitChange();
    });

    el.addEventListener('pagination:set', (e) => {
      const detail = e.detail || {};

      if (typeof detail.total === 'number') {
        state.total = detail.total;
      }

      if (typeof detail.pageSize === 'number') {
        state.pageSize = detail.pageSize;
      }

      if (typeof detail.page === 'number') {
        state.page = detail.page;
      }

      render();
    });

    render();
  })();
</script>