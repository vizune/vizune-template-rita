---
const { name, title, size } = Astro.props;
---

<svg
  width={size === "small" ? "16px" : "32px"}
  height={size === "small" ? "16px" : "32px"}
  viewBox="0 0 640 640"
  fill="currentColor" 
  aria-hidden="true"
  role="img"
>
    {title && <title>{ title }</title>}
    <use href={`#${name}`} xlink:href={`#${name}`} />
</svg>
