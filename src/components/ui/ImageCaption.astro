---
/**
 * Image with a caption underneath, in the glass card style.
 *
 * <ImageCaption src={img.src} alt="..." width={400} height={400}>
 *   <strong>#1:</strong> Guilty Crown
 * </ImageCaption>
 *
 * Pass the caption as slot content (supports markup) or as the `caption` prop.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
  class?: string;
}

const { src, alt, width = 400, height = 400, caption, class: className } = Astro.props;
const hasCaption = Astro.slots.has('default') || caption;
---

<figure
  class:list={['image-caption', className]}
  style={`max-width: ${width}px`}
>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    class="image"
    style={`aspect-ratio: ${width} / ${height}`}
  />

  {hasCaption && (
    <figcaption class="caption">
      <slot>{caption}</slot>
    </figcaption>
  )}
</figure>

<style>
.image-caption {
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 0.1);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  background-color: rgb(255 255 255 / 0.05);
  backdrop-filter: blur(var(--blur-md));
}

.image {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
}

.caption {
  padding: 0.75rem;
  color: rgb(255 255 255 / 0.8);
  text-align: center;
}
</style>
