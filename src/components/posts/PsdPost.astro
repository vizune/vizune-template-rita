---
import Icon from '../ui/Icon.astro';

type PsdPost = {
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    url?: string;
    publishDate?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: PsdPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;

const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled PSD';
const fileSize = post.fields.fileSize ?? '';
const downloadUrl = post.fields.url ?? '#';

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'PSD thumbnail';
  
const trackingId = `psd-${post.sys.id}`;
---

<article
  class="psd-card glass"
  id={trackingId}
>
  <h2 class="title">
    {title}
  </h2>

  {imgUrl ? (
    <div class="thumb">
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="thumb--empty">
      No thumbnail
    </div>
  )}

  <div class="actions">
    <a
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-psd-download
      data-psd-title={title}
      data-psd-size={fileSize}
      class="Button download-button download"
    >
      Download{fileSize ? ` (${fileSize})` : ''} <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </a>
  </div>
</article>

<script is:inline define:vars={{ trackingId }}>
  const root = document.getElementById(trackingId);
  const link = root?.querySelector('[data-psd-download]');

  if (link && link.dataset.gaBound !== '1') {
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-psd-title') || '';
      const fileSize = link.getAttribute('data-psd-size') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'psd_download_click', {
          psd_title: title,
          file_size: fileSize,
          location: 'psd_page',
        });
      }
    });
  }
</script>

<style>
.psd-card {
  overflow: hidden;
  transition: border-color var(--transition);
}

.psd-card:hover {
  border-color: rgb(255 255 255 / 0.2);
}

.title {
  padding-top: 1rem;
  font-size: var(--text-3xl);
  line-height: var(--leading-3xl);
  text-align: center;
}

.thumb {
  display: flex;
  justify-content: center;
  padding: 1rem;
}

.thumb img {
  max-height: 150px;
  object-fit: contain;
}

.thumb--empty {
  padding: 1rem;
  color: rgb(0 0 0 / 0.4);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  text-align: center;
}

.actions {
  display: flex;
  justify-content: center;
  padding: 0 1rem 1rem;
}

.download {
  margin-top: 1rem;
}
</style>
