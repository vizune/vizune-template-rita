---
import Icon from '../ui/Icon.astro';

type Tag = { sys: { id: string } };

type RenderPost = {
  metadata: { tags?: Tag[] };
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    date?: string;
    imageDimensions?: string;
    thumbnail?: { sys?: { id?: string } };
    downloadUrl?: string;
    index?: number;
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: RenderPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  post.fields.title ||
  'Render thumbnail';


const tags = (post.metadata.tags ?? []).map(t => t.sys.id).filter(Boolean);
const filterableTags = tags.filter(t => t !== 'renders');

const title = post.fields.title ?? 'Untitled render';
const fileSize = post.fields.fileSize ?? '';
const downloadUrl = post.fields.downloadUrl ?? '#';
const publishDate = post.fields.date ?? '';
const dimensions = post.fields.imageDimensions ?? '';

// Split on the first ": " only
const splitTitle = (t: string) => {
  const idx = t.indexOf(': ');
  if (idx === -1) return { prefix: '', rest: t };
  return {
    prefix: t.slice(0, idx + 2), // includes ": "
    rest: t.slice(idx + 2),
  };
};

const { prefix, rest } = splitTitle(title);

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB'); // e.g. 26/11/2023
}

const publishDateUk = formatUkDate(publishDate);
---
<article
  class="render-card bg-white/5 border border-white/10 rounded-2xl overflow-hidden
         backdrop-blur-md shadow-lg hover:border-white/20 transition"
  data-tags={filterableTags.join(' ')}
>
  {imgUrl ? (
    <div class="bg-black/20">
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="w-full h-full"
      />
    </div>
  ) : (
    <div class="aspect-[16/10] bg-black/20 flex items-center justify-center text-white/50 text-sm">
      No thumbnail
    </div>
  )}

  <div class="p-4">
    <h3 class="text-white text-xl font-bold leading-snug text-center mb-6">
      {prefix ? (
        <>
          <span>{prefix}</span>
          <br />
          <span>{rest}</span>
        </>
      ) : (
        <span>{rest}</span>
      )}
    </h3>

    <div class="text-white/90 space-y-1 border-t-1 pt-5">
      {publishDateUk ? (
        <p><span class="font-semibold">📅 Publish Date:</span> {publishDateUk}</p>
      ) : null}

      {dimensions ? (
        <p><span class="font-semibold">📐 Dimensions:</span> {dimensions}</p>
      ) : null}

      {fileSize ? (
        <p><span class="font-semibold">💾 File Size:</span> {fileSize}</p>
      ) : null}
    </div>

    <a
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-render-download
      data-render-title={title}
      class="Button mt-4 text-lg uppercase inline-flex w-full items-center justify-center gap-2
            h-10 rounded-xl px-4 bg-white/10 text-white/90 border border-white/10
            hover:bg-white/15 hover:border-white/20 transition"
    >
      Download
      <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </a>
  </div>
</article>

<script is:inline>
  document.querySelectorAll('[data-render-download]').forEach(link => {
    if (link.dataset.gaBound === '1') return;
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-render-title') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'render_download_click', {
          render_title: title,
          location: 'renders_page'
        });
      }
    });
  });
</script>
