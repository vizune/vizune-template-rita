---
import Icon from '../ui/Icon.astro';

type Tag = { sys: { id: string } };

type RenderPost = {
  metadata: { tags?: Tag[] };
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    date?: string;
    imageDimensions?: string;
    thumbnail?: { sys?: { id?: string } };
    downloadUrl?: string;
    index?: number;
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: RenderPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  post.fields.title ||
  'Render thumbnail';


const tags = (post.metadata.tags ?? []).map(t => t.sys.id).filter(Boolean);
const filterableTags = tags.filter(t => t !== 'renders');

const title = post.fields.title ?? 'Untitled render';
const fileSize = post.fields.fileSize ?? '';
const downloadUrl = post.fields.downloadUrl ?? '#';
const publishDate = post.fields.date ?? '';
const dimensions = post.fields.imageDimensions ?? '';

// Split on the first ": " only
const splitTitle = (t: string) => {
  const idx = t.indexOf(': ');
  if (idx === -1) return { prefix: '', rest: t };
  return {
    prefix: t.slice(0, idx + 2), // includes ": "
    rest: t.slice(idx + 2),
  };
};

const { prefix, rest } = splitTitle(title);

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB'); // e.g. 26/11/2023
}

const publishDateUk = formatUkDate(publishDate);
---
<article
  class="render-card glass"
  data-tags={filterableTags.join(' ')}
>
  {imgUrl ? (
    <div class="thumb">
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="thumb thumb--empty">
      No thumbnail
    </div>
  )}

  <div class="body">
    <h3 class="title">
      {prefix ? (
        <>
          <span>{prefix}</span>
          <br />
          <span>{rest}</span>
        </>
      ) : (
        <span>{rest}</span>
      )}
    </h3>

    <div class="meta">
      {publishDateUk ? (
        <p><span class="meta-label">📅 Publish Date:</span> {publishDateUk}</p>
      ) : null}

      {dimensions ? (
        <p><span class="meta-label">📐 Dimensions:</span> {dimensions}</p>
      ) : null}

      {fileSize ? (
        <p><span class="meta-label">💾 File Size:</span> {fileSize}</p>
      ) : null}
    </div>

    <a
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-render-download
      data-render-title={title}
      class="Button download-button download"
    >
      Download
      <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </a>
  </div>
</article>

<script is:inline>
  document.querySelectorAll('[data-render-download]').forEach(link => {
    if (link.dataset.gaBound === '1') return;
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-render-title') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'render_download_click', {
          render_title: title,
          location: 'renders_page'
        });
      }
    });
  });
</script>

<style>
.render-card {
  overflow: hidden;
  transition: border-color var(--transition);
}

.render-card:hover {
  border-color: rgb(255 255 255 / 0.2);
}

.thumb {
  height: 250px;
  overflow: hidden;
  background-color: rgb(0 0 0 / 0.2);
}

.thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.thumb--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgb(255 255 255 / 0.5);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
}

.body {
  padding: 1rem;
}

.title {
  margin-bottom: 1.5rem;
  color: #fff;
  font-size: var(--text-xl);
  line-height: 1.375;
  text-align: center;
}

.meta {
  padding-top: 1.25rem;
  border-top-width: 1px;
  color: rgb(255 255 255 / 0.9);
}

.meta-label {
  font-weight: 600;
}

.download {
  margin-top: 1rem;
}
</style>
