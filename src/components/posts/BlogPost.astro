---
type ArticlePost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
    banner?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: ArticlePost;
  assetsById: Map<string, Asset>;
  featured?: boolean;
}

const { post, assetsById, featured = false } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const bannerId = post.fields.banner?.sys?.id;
const thumbAsset = thumbId ? assetsById.get(thumbId) : undefined;
const bannerAsset = bannerId ? assetsById.get(bannerId) : undefined;
const asset = featured ? bannerAsset : thumbAsset;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled post';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Blog post thumbnail';
---

<a
  href={`/blog/${slug}/`}
  data-blog-click
  data-blog-title={title}
  data-blog-slug={slug}
  class:list={[
    'blog-card card block group rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-lg overflow-hidden hover:border-white/20 hover:bg-white/[0.07] transition focus:outline-none focus:ring-2 focus:ring-lavender/60',
    featured ? 'flex' : 'md:grid md:grid-cols-[250px_1fr]',
  ]}
>
  {imgUrl ? (
    <div class:list={[
      'bg-black/20 md:border-r border-white/10 overflow-hidden',
      featured ? 'h-[450px] w-[768px]' : 'h-[250px] w-[250px]',
    ]}>
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>
  ) : (
    <div class:list={[
      'bg-black/20 md:border-r border-white/10 flex items-center justify-center text-white/50 text-sm',
      featured ? 'h-[280px] md:h-full' : 'h-[250px] md:w-[250px] md:h-[250px]',
    ]}>
      No thumbnail
    </div>
  )}

  <article class:list={[
    'p-5 flex flex-col justify-center',
    featured ? 'md:p-8' : '',
  ]}>
    <p class="text-white/60 text-sm mb-3">
      {publishDate}
    </p>

    <h3 class:list={[
      'text-white font-semibold mb-3 transition group-hover:text-lavender underline group-hover:no-underline',
      featured ? 'text-3xl' : 'text-xl',
    ]}>
      {title}
    </h3>

    {description ? (
      <p class:list={[
        'text-white/80',
        featured ? 'text-lg' : '',
      ]}>
        {description}
      </p>
    ) : null}
  </article>
</a>

<style>
  .blog-card:hover img {
    transform: scale(1.04);
  }

  .blog-card img {
    transition: transform 0.4s ease;
  }
</style>