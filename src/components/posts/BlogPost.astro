---
type ArticlePost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
    banner?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: ArticlePost;
  assetsById: Map<string, Asset>;
  featured?: boolean;
}

const { post, assetsById, featured = false } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const bannerId = post.fields.banner?.sys?.id;
const thumbAsset = thumbId ? assetsById.get(thumbId) : undefined;
const bannerAsset = bannerId ? assetsById.get(bannerId) : undefined;
const asset = featured ? bannerAsset : thumbAsset;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled post';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Blog post thumbnail';
---

<a
  href={`/blog/${slug}/`}
  data-blog-click
  data-blog-title={title}
  data-blog-slug={slug}
  class:list={['blog-card card glass', { featured }]}
>
  {imgUrl ? (
    <div class="thumb">
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="thumb thumb--empty">
      No thumbnail
    </div>
  )}

  <article class="body">
    <p class="date">
      {publishDate}
    </p>

    <h3 class="title">
      {title}
    </h3>

    {description ? (
      <p class="description">
        {description}
      </p>
    ) : null}
  </article>
</a>

<style>
  .blog-card {
    display: block;
    overflow: hidden;
    transition: border-color var(--transition), background-color var(--transition), box-shadow var(--transition);
  }

  .blog-card:hover {
    border-color: rgb(255 255 255 / 0.2);
    background-color: rgb(255 255 255 / 0.07);
  }

  .blog-card:focus {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-lavender) 60%, transparent), var(--shadow-lg);
  }

  .thumb {
    width: 250px;
    height: 250px;
    margin-inline: auto;
    overflow: hidden;
    border-color: rgb(255 255 255 / 0.1);
    background-color: rgb(0 0 0 / 0.2);
  }

  .featured .thumb {
    width: 768px;
    height: 400px;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover img {
    transform: scale(1.04);
  }

  .thumb--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    margin-inline: 0;
    color: rgb(255 255 255 / 0.5);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .featured .thumb--empty {
    width: auto;
    height: 280px;
  }

  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem;
  }

  .date {
    color: rgb(255 255 255 / 0.6);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .title {
    margin-bottom: 0.75rem;
    color: #fff;
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    text-decoration-line: underline;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .featured .title {
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
  }

  .blog-card:hover .title {
    color: var(--color-lavender);
    text-decoration-line: none;
  }

  .description {
    color: rgb(255 255 255 / 0.8);
  }

  .featured .description {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  @media (min-width: 768px) {
    .featured {
      display: flex;
    }

    .thumb {
      border-right-width: 1px;
    }

    .thumb--empty {
      width: 250px;
    }

    .featured .thumb--empty {
      width: auto;
      height: 100%;
    }

    .featured .body {
      padding: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .blog-card:not(.featured) {
      display: grid;
      grid-template-columns: 250px 1fr;
    }
  }
</style>
