---
type TutorialPost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: TutorialPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled tutorial';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Tutorial thumbnail';

const trackingId = `tutorial-card-${post.sys.id}`;
---

<a
  id={trackingId}
  href={`/tutorials/${slug}/`}
  data-tutorial-click
  data-tutorial-title={title}
  data-tutorial-slug={slug}
  class="tutorial-card card glass"
>
  <article>
    <div class="layout">
      {imgUrl ? (
        <div class="thumb">
          <img
            src={imgUrl}
            alt={alt}
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : (
        <div class="thumb thumb--empty">
          No thumbnail
        </div>
      )}

      <div class="body">
        <h2 class="title">
          {title}
        </h2>

        {publishDate ? <p class="date">📅 {publishDate}</p> : null}

        {description ? <p class="description">{description}</p> : null}
      </div>
    </div>
  </article>
</a>

<script is:inline define:vars={{ trackingId }}>
  const link = document.getElementById(trackingId);

  if (link && link.dataset.gaBound !== '1') {
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-tutorial-title') || '';
      const slug = link.getAttribute('data-tutorial-slug') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'tutorial_click', {
          tutorial_title: title,
          tutorial_slug: slug,
          location: 'tutorials_page',
        });
      }
    });
  }
</script>

<style>
  .tutorial-card {
    display: block;
    overflow: hidden;
    transition: border-color var(--transition), background-color var(--transition), box-shadow var(--transition);
  }

  .tutorial-card:hover {
    border-color: rgb(255 255 255 / 0.2);
    background-color: rgb(255 255 255 / 0.07);
  }

  .tutorial-card:focus {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-lavender) 60%, transparent), var(--shadow-lg);
  }

  .layout {
    display: grid;
  }

  .thumb {
    width: 100%;
    height: 250px;
    overflow: hidden;
    border-color: rgb(255 255 255 / 0.1);
    background-color: rgb(0 0 0 / 0.2);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .tutorial-card:hover img {
    transform: scale(1.04);
  }

  .thumb--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(255 255 255 / 0.5);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem;
  }

  .title {
    margin-bottom: 0.5rem;
    color: #fff;
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    text-decoration: underline;
    transition: color var(--transition);
  }

  .tutorial-card:hover .title {
    color: var(--color-lavender);
    text-decoration: none;
  }

  .date {
    color: rgb(255 255 255 / 0.6);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .description {
    color: rgb(255 255 255 / 0.8);
  }

  @media (min-width: 768px) {
    .layout {
      grid-template-columns: 250px 1fr;
    }

    .thumb {
      width: 250px;
      border-right-width: 1px;
    }
  }
</style>
