---
/**
 * Tarot-style template carousel: card spread, prev/next arrows and a details panel.
 * Used on /templates/ and /style-guide/.
 *
 * <TemplateCarousel posts={sorted} assetsById={assetsById} />
 */
import Icon from '@/components/ui/Icon.astro';
import TemplatePost from '@/components/posts/TemplatePost.astro';
import arrowPng from '@/assets/arrow.png';

interface Props {
  posts: any[];
  assetsById: Map<string, any>;
  /** Index of the card shown in the centre on load */
  startIndex?: number;
  /** Analytics location label sent with template_click events */
  location?: string;
}

const { posts, assetsById, startIndex = 0, location = 'templates_page' } = Astro.props as Props;
---

<section class="relative pb-10" data-tarot-root data-start-index={startIndex} data-location={location}>
  <div class="text-center mb-8">
    <p class="mb-3 text-white/70 text-sm">Explore the template spread • Select a card to reveal its details</p>
  </div>

  <div class="mx-auto max-w-6xl px-4">
    <div class="relative min-h-[560px] flex flex-col items-center justify-center gap-2">
      <div class="tarot-spread relative w-full max-w-5xl h-[420px] sm:h-[460px] md:h-[520px]" data-spread>
        {posts.map((post, idx) => (
          <TemplatePost post={post} assetsById={assetsById} index={idx} />
        ))}
      </div>

      <div class="flex items-center gap-8 mb-8">
        <button
          type="button"
          aria-label="Previous templates"
          data-prev
          class="h-18 w-18 rounded-full border border-white/20 bg-black/40
                 text-white/90 backdrop-blur-md hover:border-white/50 transition
                 disabled:opacity-40 disabled:cursor-not-allowed
                 flex items-center justify-center"
        >
          <img src={arrowPng.src} alt="" aria-hidden="true" class="w-[45px] h-[30px] rotate-180" />
        </button>

        <button
          type="button"
          aria-label="Next templates"
          data-next
          class="h-18 w-18 rounded-full border border-white/20 bg-black/40
                 text-white/90 backdrop-blur-md hover:border-white/50 transition
                 disabled:opacity-40 disabled:cursor-not-allowed
                 flex items-center justify-center"
        >
          <img src={arrowPng.src} alt="" aria-hidden="true" class="w-[45px] h-[30px]" />
        </button>
      </div>
    </div>

    <div
      class="mx-auto max-w-6xl rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-lg shadow-black/30 overflow-hidden"
      data-template-details
    >
      <div class="grid md:grid-cols-[1fr_360px]">
        <div class="p-5 md:p-6 text-white/90 space-y-2" data-template-meta></div>
        <div class="border-t md:border-t-0 md:border-l border-white/10 grid gap-px bg-white/10" data-template-links></div>
      </div>
    </div>
  </div>

  <template data-new-tab-icon>
    <Icon name="newTab" title="Opens url in a new tab" />
  </template>
</section>

<script is:inline>
  // Runs once per carousel on the page; each instance is scoped to its own root.
  document.querySelectorAll('[data-tarot-root]:not([data-tarot-ready])').forEach((root) => {
    root.setAttribute('data-tarot-ready', '');

    const cards = Array.from(root.querySelectorAll('[data-card]'));
    const prevBtn = root.querySelector('[data-prev]');
    const nextBtn = root.querySelector('[data-next]');
    const meta = root.querySelector('[data-template-meta]');
    const links = root.querySelector('[data-template-links]');
    const newTabIcon = root.querySelector('[data-new-tab-icon]')?.innerHTML ?? '';
    const location = root.dataset.location || 'templates_page';

    if (!cards.length) return;

    let activeIndex = Math.min(Math.max(0, Number(root.dataset.startIndex) || 0), cards.length - 1);
    let isAnimating = false;

    function formatUkDate(value) {
      if (!value) return '';
      const t = Date.parse(value);
      if (!Number.isFinite(t)) return value;
      return new Date(t).toLocaleDateString('en-GB');
    }

    function renderDetails(card) {
      if (!meta || !links || !card) return;
      const d = card.dataset;

      meta.innerHTML = [
        ['Publish Date', formatUkDate(d.publishDate)],
        ['Tech Stack', d.techStack],
        ['Category', d.category],
        ['Series', d.series],
        ['Character', d.character],
      ]
        .filter(([, value]) => value)
        .map(([label, value]) => `<p><strong>${label}:</strong> ${value}</p>`)
        .join('');

      const items = [
        d.demoUrl ? { label: 'Demo', href: d.demoUrl, action: 'demo' } : null,
        d.repoUrl ? { label: 'Source code', href: d.repoUrl, action: 'repo' } : null,
        d.downloadUrl ? { label: 'Download .zip', href: d.downloadUrl, action: 'download' } : null,
      ].filter(Boolean);

      links.innerHTML = items.map((item) => `
        <a
          href="${item.href}"
          target="_blank"
          rel="noopener noreferrer"
          data-template-action="${item.action}"
          class="flex items-center justify-between gap-4
                 bg-white/5 px-4 py-5 text-white/90
                 hover:bg-white/15 hover:text-white transition"
        >
          <span>${item.label}</span>
          <span aria-hidden="true" class="text-white/60 [&_svg]:h-5 [&_svg]:w-5">${newTabIcon}</span>
        </a>
      `).join('');

      links.querySelectorAll('[data-template-action]').forEach((link) => {
        link.addEventListener('click', () => {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'template_click', {
              template_name: d.title || '',
              action: link.dataset.templateAction,
              location,
            });
          }
        });
      });
    }

    function render() {
      cards.forEach((card, index) => {
        card.classList.remove('is-left', 'is-center', 'is-right', 'is-hidden');
        if (index === activeIndex - 1) card.classList.add('is-left');
        else if (index === activeIndex) card.classList.add('is-center');
        else if (index === activeIndex + 1) card.classList.add('is-right');
        else card.classList.add('is-hidden');
      });

      renderDetails(cards[activeIndex]);

      if (prevBtn) prevBtn.disabled = isAnimating || activeIndex === 0;
      if (nextBtn) nextBtn.disabled = isAnimating || activeIndex === cards.length - 1;
    }

    function moveTo(nextIndex) {
      if (isAnimating) return;
      const clamped = Math.max(0, Math.min(cards.length - 1, nextIndex));
      if (clamped === activeIndex) return;

      isAnimating = true;
      activeIndex = clamped;
      render();

      window.setTimeout(() => {
        isAnimating = false;
        render();
      }, 450);
    }

    prevBtn?.addEventListener('click', () => moveTo(activeIndex - 1));
    nextBtn?.addEventListener('click', () => moveTo(activeIndex + 1));

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const index = Number(card.getAttribute('data-index') || 0);
        if (Math.abs(index - activeIndex) === 1) moveTo(index);
      });
    });

    render();
  });
</script>
