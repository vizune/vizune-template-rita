---
/**
 * Tarot-style template carousel: card spread, prev/next arrows and a details panel.
 * Used on /templates/ and /style-guide/.
 *
 * <TemplateCarousel posts={sorted} assetsById={assetsById} />
 */
import Icon from '@/components/ui/Icon.astro';
import TemplatePost from '@/components/posts/TemplatePost.astro';
import arrowPng from '@/assets/arrow.png';

interface Props {
  posts: any[];
  assetsById: Map<string, any>;
  /** Index of the card shown in the centre on load */
  startIndex?: number;
  /** Analytics location label sent with template_click events */
  location?: string;
}

const { posts, assetsById, startIndex = 0, location = 'templates_page' } = Astro.props as Props;
---

<section class="carousel" data-tarot-root data-start-index={startIndex} data-location={location}>
  <div class="intro">
    <p class="intro-text">Explore the template spread • Select a card to reveal its details</p>
  </div>

  <div class="inner">
    <div class="stage">
      <div class="tarot-spread" data-spread>
        {posts.map((post, idx) => (
          <TemplatePost post={post} assetsById={assetsById} index={idx} />
        ))}
      </div>

      <div class="controls">
        <button
          type="button"
          aria-label="Previous templates"
          data-prev
          class="round-button round-button--prev"
        >
          <img src={arrowPng.src} alt="" aria-hidden="true" />
        </button>

        <button
          type="button"
          aria-label="Next templates"
          data-next
          class="round-button"
        >
          <img src={arrowPng.src} alt="" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div
      class="details glass"
      data-template-details
    >
      <div class="details-grid">
        <div class="meta" data-template-meta></div>
        <div class="links" data-template-links></div>
      </div>
    </div>
  </div>

  <template data-new-tab-icon>
    <Icon name="newTab" title="Opens url in a new tab" />
  </template>
</section>

<script is:inline>
  // Runs once per carousel on the page; each instance is scoped to its own root.
  document.querySelectorAll('[data-tarot-root]:not([data-tarot-ready])').forEach((root) => {
    root.setAttribute('data-tarot-ready', '');

    const cards = Array.from(root.querySelectorAll('[data-card]'));
    const prevBtn = root.querySelector('[data-prev]');
    const nextBtn = root.querySelector('[data-next]');
    const meta = root.querySelector('[data-template-meta]');
    const links = root.querySelector('[data-template-links]');
    const newTabIcon = root.querySelector('[data-new-tab-icon]')?.innerHTML ?? '';
    const location = root.dataset.location || 'templates_page';

    if (!cards.length) return;

    let activeIndex = Math.min(Math.max(0, Number(root.dataset.startIndex) || 0), cards.length - 1);
    let isAnimating = false;

    function formatUkDate(value) {
      if (!value) return '';
      const t = Date.parse(value);
      if (!Number.isFinite(t)) return value;
      return new Date(t).toLocaleDateString('en-GB');
    }

    function renderDetails(card) {
      if (!meta || !links || !card) return;
      const d = card.dataset;

      meta.innerHTML = [
        ['Publish Date', formatUkDate(d.publishDate)],
        ['Tech Stack', d.techStack],
        ['Category', d.category],
        ['Series', d.series],
        ['Character', d.character],
      ]
        .filter(([, value]) => value)
        .map(([label, value]) => `<p><strong>${label}:</strong> ${value}</p>`)
        .join('');

      const items = [
        d.demoUrl ? { label: 'Demo', href: d.demoUrl, action: 'demo' } : null,
        d.repoUrl ? { label: 'Source code', href: d.repoUrl, action: 'repo' } : null,
        d.downloadUrl ? { label: 'Download .zip', href: d.downloadUrl, action: 'download' } : null,
      ].filter(Boolean);

      links.innerHTML = items.map((item) => `
        <a
          href="${item.href}"
          target="_blank"
          rel="noopener noreferrer"
          data-template-action="${item.action}"
          class="template-link"
        >
          <span>${item.label}</span>
          <span aria-hidden="true" class="template-link-icon">${newTabIcon}</span>
        </a>
      `).join('');

      links.querySelectorAll('[data-template-action]').forEach((link) => {
        link.addEventListener('click', () => {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'template_click', {
              template_name: d.title || '',
              action: link.dataset.templateAction,
              location,
            });
          }
        });
      });
    }

    function render() {
      cards.forEach((card, index) => {
        card.classList.remove('is-left', 'is-center', 'is-right', 'is-hidden');
        if (index === activeIndex - 1) card.classList.add('is-left');
        else if (index === activeIndex) card.classList.add('is-center');
        else if (index === activeIndex + 1) card.classList.add('is-right');
        else card.classList.add('is-hidden');
      });

      renderDetails(cards[activeIndex]);

      if (prevBtn) prevBtn.disabled = isAnimating || activeIndex === 0;
      if (nextBtn) nextBtn.disabled = isAnimating || activeIndex === cards.length - 1;
    }

    function moveTo(nextIndex) {
      if (isAnimating) return;
      const clamped = Math.max(0, Math.min(cards.length - 1, nextIndex));
      if (clamped === activeIndex) return;

      isAnimating = true;
      activeIndex = clamped;
      render();

      window.setTimeout(() => {
        isAnimating = false;
        render();
      }, 450);
    }

    prevBtn?.addEventListener('click', () => moveTo(activeIndex - 1));
    nextBtn?.addEventListener('click', () => moveTo(activeIndex + 1));

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const index = Number(card.getAttribute('data-index') || 0);
        if (Math.abs(index - activeIndex) === 1) moveTo(index);
      });
    });

    render();
  });
</script>

<style>
.carousel {
  position: relative;
  padding-bottom: 2.5rem;
}

.intro {
  margin-bottom: 2rem;
  text-align: center;
}

.intro-text {
  color: rgb(255 255 255 / 0.7);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
}

.inner {
  max-width: 72rem;
  margin-inline: auto;
  padding-inline: 1rem;
}

.stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 560px;
}

.tarot-spread {
  position: relative;
  width: 100%;
  max-width: 64rem;
  height: 420px;
}

@media (min-width: 640px) {
  .tarot-spread {
    height: 460px;
  }
}

@media (min-width: 768px) {
  .tarot-spread {
    height: 520px;
  }
}

.controls {
  display: flex;
  align-items: center;
  gap: 2rem;
  margin-bottom: 2rem;
}

.details {
  max-width: 72rem;
  margin-inline: auto;
  overflow: hidden;
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.3), 0 4px 6px -4px rgb(0 0 0 / 0.3);
}

.details-grid {
  display: grid;
}

.meta {
  padding: 1.25rem;
  color: rgb(255 255 255 / 0.9);
}

.links {
  display: grid;
  gap: 1px;
  border-top: 1px solid rgb(255 255 255 / 0.1);
  background-color: rgb(255 255 255 / 0.1);
}

@media (min-width: 768px) {
  .details-grid {
    grid-template-columns: 1fr 360px;
  }

  .meta {
    padding: 1.5rem;
  }

  .links {
    border-top-width: 0;
    border-left: 1px solid rgb(255 255 255 / 0.1);
  }
}

/* Links are rendered by the script below, so they need :global() */
.links :global(.template-link) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1rem;
  background-color: rgb(255 255 255 / 0.05);
  color: rgb(255 255 255 / 0.9);
  transition: background-color var(--transition), color var(--transition);
}

.links :global(.template-link:hover) {
  background-color: rgb(255 255 255 / 0.15);
  color: #fff;
}

.links :global(.template-link-icon) {
  color: rgb(255 255 255 / 0.6);
}

.links :global(.template-link-icon svg) {
  width: 1.25rem;
  height: 1.25rem;
}
</style>
