---
import { Image } from 'astro:assets';
import { Icon } from '@/components';
import SocialImage from '@/assets/social.png';
const { sub, heading } = Astro.props;

const socials = [
  { name: 'codepen', href: 'https://codepen.io/SRichardson', label: 'CodePen' },
  { name: 'deviantart', href: 'https://www.deviantart.com/vizune', label: 'DeviantArt' },
  { name: 'github', href: 'https://github.com/vizune', label: 'GitHub' },
  { name: 'instagram', href: 'https://www.instagram.com/vizune_/', label: 'Instagram' },
  { name: 'linkedin', href: 'https://www.linkedin.com/in/sasha-r-547a2b57', label: 'LinkedIn' },
  { name: 'pinterest',  href: 'https://uk.pinterest.com/vizune/',   label: 'Pinterest' },
  { name: 'spotify', href: 'https://open.spotify.com/user/1149827575', label: 'Spotify' },
  { name: 'steam', href: 'https://steamcommunity.com/id/vizune/', label: 'Steam' }
]
---

<div class="social">
  <ul>
    {socials.map((s) => 
      <li>
        <a
          href={s.href}
          target="_blank" rel="noopener noreferrer"
          class="social-link"
          aria-label={s.label}
          title={s.name}>
          <Icon name={s.name} title={s.label} />
        </a>
      </li>
    )}
  </ul>
  <Image
    src={SocialImage}
    alt=""
    role="presentation"
    width={300}
    height={300}
    class="social-image"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .social {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 375px;
    height: 375px;
    margin: 1.5rem auto;
  }

  @media (min-width: 640px) {
    .social {
      width: 400px;
      height: 400px;
    }
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: #fff;
    transition: color var(--transition);
  }

  .social-link:hover {
    color: var(--color-lavender);
  }

  @media (min-width: 640px) {
    .social-link {
      box-shadow: 0 0 0 2px var(--color-lavender);
    }
  }

  .social-image {
    width: 300px;
    height: 300px;
  }

  li {
    position: absolute;
  }

  li:first-child {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }
  li:nth-child(2) {
    top: 15%;
    left: 75%;
  }
  li:nth-child(3) {
    top: 50%;
    right: 0;
    transform: translateY(-50%);
  }
  li:nth-child(4) {
    top: 75%;
    left: 75%;
  }
  li:nth-child(5) {
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }
  li:nth-child(6) {
    top: 75%;
    right: 75%;
  }
  li:nth-child(7) {
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  li:nth-child(8) {
    top: 15%;
    right: 75%;
  }
</style>